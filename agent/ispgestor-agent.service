[Unit]
Description=Agente de aprovisionamiento de ISP Gestor
Documentation=https://github.com/ironlink/ispgestor
After=network-online.target
Wants=network-online.target
# Un agente que no arranca deja de detectar equipos en silencio; conviene que
# systemd insista indefinidamente en vez de rendirse tras unos intentos.
# Va en [Unit] y no en [Service]: ahí systemd la ignora con un aviso.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/ispgestor-agent/venv/bin/python -m ispgestor_agent run
WorkingDirectory=/opt/ispgestor-agent

# Root es necesario en ambos roles y por motivos distintos: el `provisioner`
# tiene que abrir el puerto UDP 5678 (privilegiado) para escuchar MNDP, y el
# `vpn_host` tiene que administrar la interfaz WireGuard del sistema.
User=root

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ispgestor-agent

# Endurecimiento: el agente no necesita tocar nada del sistema salvo su propia
# configuración y, en el rol vpn_host, el directorio de WireGuard.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

# El guion de `-/etc/wireguard` NO es decorativo: sin él systemd exige que la
# ruta exista y, si falta, se niega a montar el espacio de nombres y mata el
# proceso antes de arrancarlo (status=226/NAMESPACE, «Failed to set up mount
# namespacing»).
#
# Solo el rol `vpn_host` tiene WireGuard instalado. En la máquina de una oficina
# —que es un `provisioner`— ese directorio no existe, así que el agente entraba
# en bucle de reinicio nada más instalarse. No se vio en el hosting porque allí
# sí existe, y es el sitio donde se probó.
ReadWritePaths=/etc/ispgestor-agent -/etc/wireguard
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
