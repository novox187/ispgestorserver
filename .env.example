APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ispgestorserver
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── MikroTik (RouterOS) ──────────────────────────────────────────────────────
# La configuración del/los routers (host, usuario, contraseña, puerto, red de
# clientes, gateway) se administra 100% desde el panel:
# MikroTik → Dispositivos. El primer router registrado se marca automáticamente
# como Principal y es el usado por todas las funcionalidades del sistema
# (firewall, sincronización, monitoreo, suspensiones). NO existen variables de
# entorno MIKROTIK_* — se eliminaron para evitar configuración divergente.

# ── Billing Workers ──────────────────────────────────────────────────────────
BILLING_SUSPENSION_GRACE_DAYS=3
BILLING_TIMEZONE=America/Bogota
BILLING_SCHEDULE_INVOICE_DAY=1
BILLING_SCHEDULE_INVOICE_TIME=00:05
BILLING_SCHEDULE_PAYMENTS_TIME=02:00
BILLING_SCHEDULE_SUSPEND_TIME=08:00
BILLING_SCHEDULE_REACTIVATE_TIME=10:00
BILLING_SCHEDULE_MKSYNC_HOUR1=6
BILLING_SCHEDULE_MKSYNC_HOUR2=18
BILLING_QUEUE_SUSPENSIONS=suspensions
BILLING_QUEUE_REACTIVATIONS=reactivations

# ── Módulo de Notificaciones ─────────────────────────────────────────────────
# El módulo de notificaciones se administra 100% desde el panel:
# Configuraciones → Notificaciones.
#
# Las credenciales (bot tokens), chat IDs y settings de cada canal viven en
# la base de datos (tablas notification_channel_configs y notification_event_routes)
# y NO se leen de variables de entorno. Tras un `migrate --seed` el seeder
# `NotificationSettingsSeeder` crea filas placeholder deshabilitadas; el
# admin debe entrar al panel para activar y configurar cada canal.
